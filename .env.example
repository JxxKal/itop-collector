# Kopieren nach .env und ausfuellen. .env ist per .gitignore ausgeschlossen.
#
#   cp .env.example .env && $EDITOR .env

# --- iTop -------------------------------------------------------------------

# Passwort des MariaDB-Benutzers "itop". Wird von iTop und vom DB-Container
# gelesen und muss auf beiden Seiten identisch sein.
ITOP_DB_PASSWORD=bitte-aendern

# iTop-Konto, unter dem Collector und Cron arbeiten.
#
# ACHTUNG: iTops cron.php verlangt zwingend das Profil "Administrator"
# (webservices/cron.php:481, UserRights::IsAdministrator). SuperUser genuegt
# NICHT. Der Collector selbst braucht nur "REST Services User".
#
# Produktiv gehoeren das deshalb ZWEI Konten: eines mit Administrator fuer den
# Cron, eines mit REST Services User fuer den Collector. Sonst sind die
# Collector-Zugangsdaten faktisch Admin-Zugangsdaten.
ITOP_USER=syncagent
ITOP_PASSWORD=bitte-aendern

# Organisation, unter der neu angelegte CIs entstehen (iTop-ID, keine Zeichenkette).
# Greift nur bei der Anlage - danach fasst der Agent das Feld nie wieder an.
ITOP_DEFAULT_ORG_ID=1

# --- Collector --------------------------------------------------------------

# Einmal-Token, mit dem sich Agenten registrieren. Der Installer bringt es mit;
# der Agent tauscht es gegen ein geraetespezifisches Token.
# Etwas Zufaelliges nehmen, z.B.:  openssl rand -hex 32
COLLECTOR_ENROLL_TOKEN=bitte-aendern

# --- Ports ------------------------------------------------------------------

# Vorgaben passen, solange die Ports frei sind. 8888 ist bewusst NICHT die
# Vorgabe - dort sitzt haeufig schon etwas anderes.
ITOP_HTTPS_PORT=8889
COLLECTOR_PORT=8890
