    <!-- VirtualMachine. -->
    <class id="VirtualMachine" _delta="must_exist">
      <presentation>
        <details>
          <items>
            <item id="col:col1">
              <items>
                <item id="fieldset:Server:moreinfo">
                  <items>
                    <item id="macaddress" _delta="define_if_not_exists">
                      <rank>26</rank>
